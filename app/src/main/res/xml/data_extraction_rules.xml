<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: progress photos stay on the phone only (no cloud backup, no device transfer). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
